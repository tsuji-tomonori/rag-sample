{
  "name": "@rag-engineering/infra",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test -r ts-node/register test/*.test.ts",
    "synth": "cdk synth",
    "docs": "node -r ts-node/register scripts/generate-inventory.ts",
    "docs:check": "node -r ts-node/register scripts/generate-inventory.ts --check"
  },
  "dependencies": { "aws-cdk-lib": "^2.261.0", "constructs": "^10.4.2", "cdk-nag": "^2.37.0" },
  "devDependencies": { "@types/node": "^24.0.0", "aws-cdk": "^2.1020.0", "ts-node": "^10.9.2", "typescript": "^5.9.0" }
}

