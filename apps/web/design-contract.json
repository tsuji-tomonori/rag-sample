{
  "schemaVersion": 1,
  "views": [
    { "id": "knowledge", "label": "根拠を登録する", "permission": "admin" },
    { "id": "inquiry", "label": "根拠から回答する", "permission": "authenticated" }
  ],
  "actions": [
    {
      "id": "ingestDocument",
      "label": "文書を取り込む",
      "endpoint": "POST /v1/documents",
      "permission": "admin",
      "states": ["idle", "loading", "success", "permission-denied", "error"]
    },
    {
      "id": "generateGroundedAnswer",
      "label": "回答を検証する",
      "endpoint": "POST /v1/answers",
      "permission": "authenticated",
      "states": ["idle", "loading", "answered", "insufficient-evidence", "error"]
    }
  ],
  "authModes": [
    { "id": "local", "identitySource": "explicit local input", "production": false },
    { "id": "cognito", "identitySource": "verified OIDC access token", "production": true }
  ],
  "realtime": {
    "transport": "AppSync GraphQL WebSocket",
    "channel": "verified subject",
    "event": "INGESTION status"
  }
}
